"role":"p","meals":["B","D","S1"],"draft":true,"src":"تقدير محلي — يحتاج مطابقة بجداول التركيب الغذائي المحلية"},{"id":"L013","g":"ألبان","n":"لبنة قليلة الدسم","st":"جاهز","k":115,"p":10,"c":6,"f":5.5,"fi":0.0,"su":0.0,"na":250,"ms":"1 ملعقة كبيرة = 20 جم","role":"p","meals":["B","D","S1","N"],"draft":true,"src":"تقدير محلي — يحتاج مطابقة بجداول التركيب الغذائي المحلية"},{"id":"L014","g":"دهون ومكسرات","n":"كريمة طبخ","st":"جاهز","k":340,"p":2,"c":3,"f":36.0,"fi":0.0,"su":0.0,"na":30,"ms":"1 ملعقة كبيرة = 15 جم","role":"f","meals":["B","L","D"],"draft":true,"src":"تقدير محلي — يحتاج مطابقة بجداول التركيب الغذائي المحلية"},{"id":"L015","g":"دهون ومكسرات","n":"زيتون أخضر","st":"معلب","k":115,"p":1,"c":4,"f":11.0,"fi":3.0,"su":0.0,"na":1500,"ms":"10 حبات = 40 جم","role":"f","meals":["B","L","D","S1"],"draft":true,"src":"تقدير محلي — يحتاج مطابقة بجداول التركيب الغذائي المحلية"},{"id":"L016","g":"خضروات","n":"أرز القرنبيط (مطبوخ)","st":"مطبوخ","k":30,"p":2,"c":5,"f":0.3,"fi":2.0,"su":0.0,"na":30,"ms":"1 كوب = 120 جم","role":"v","meals":["L","D"],"draft":true,"src":"تقدير محلي — يحتاج مطابقة بجداول التركيب الغذائي المحلية"},{"id":"L017","g":"خضروات","n":"سلطة خضراء (خيار وطماطم)","st":"نيء","k":17,"p":0.8,"c":3.5,"f":0.1,"fi":1.0,"su":0.0,"na":10,"ms":"1 طبق = 200 جم","role":"v","meals":["L","D"],"draft":true,"src":"تقدير محلي — يحتاج مطابقة بجداول التركيب الغذائي المحلية"}],"guides":[["تنشيف","دعم","العجز المنضبط يصنع النتيجة؛ الصبر والثبات يغلبان التسرّع."],["تنشيف","دعم","كل وجبة تلتزم بها اليوم هي دهن أقل غداً مع عضلاتك محفوظة."],["تنشيف","دعم","الجوع جزء من الرحلة وليس علامة فشل؛ تعامل معه بالماء والخضار والبروتين."],["تنشيف","دعم","لا تقارن يومك بيوم غيرك؛ قارن أسبوعك بأسبوعك الماضي."],["تنشيف","دعم","قوتك في التمرين هي مؤشرك الأهم؛ إن حافظتَ عليها فأنت تحافظ على عضلاتك."],["تنشيف","دعم","يوم تجاوز واحد لا يهدم أسبوعاً؛ عد للخطة في وجبتك التالية."],["تنشيف","دعم","الميزان يتذبذب يومياً بسبب الماء؛ احكم على المتوسط الأسبوعي."],["تنشيف","دعم","أنت أقرب إلى هدفك مما كنت عليه الأسبوع الماضي."],["تنشيف","إرشاد","حافظ على شدة التمرين وأحماله قدر المستطاع؛ الإشارة للجسم أن يُبقي عضلاته."],["تنشيف","إرشاد","ابدأ كل وجبة بالخضار والبروتين لتزيد الشبع."],["تنشيف","إرشاد","وزّع البروتين على 3–5 وجبات متقاربة."],["تنشيف","إرشاد","اجعل الكارب حول التدريب (قبله وبعده) لتحافظ على أدائك."],["تنشيف","إرشاد","ركّز على الأغذية كثيفة الحجم قليلة السعرات (خضار، فواكه كاملة، شوربات)."],["تنشيف","إرشاد","نم 7–9 ساعات؛ قلة النوم تزيد الجوع وتضعف الاستشفاء."],["تنشيف","إرشاد","قِس وزنك صباحاً بنفس الظروف 3–4 مرات أسبوعياً وسجّل المتوسط."],["تنشيف","توقع","الهدف الشائع نزول تدريجي في الوزن (أجزاء من المئة من وزن الجسم أسبوعياً) لا نزول سريع."],["تنشيف","توقع","قد ينخفض الأداء قليلاً مع تقدم التنشيف؛ إن كان الانخفاض كبيراً أخبرني."],["تنشيف","توقع","إذا لم يتحرك اتجاه الوزن 2–3 أسابيع مع التزام كامل نعدّل السعرات أو الحركة تدريجياً — لا تعدّل وحدك."],["تنشيف","تنبيه","لا تخفّض السعرات أكثر مما في خطتك؛ العجز الكبير يضر العضلات والهرمونات والأداء."],["تنشيف","تنبيه","توقف وتواصل معي عند: دوخة مستمرة، إعياء شديد، اضطراب الدورة، أرق شديد، أو أفكار مقلقة حول الطعام والوزن."],["ما قبل المنافسة (تنشيف متقدم)","دعم","أنت في المرحلة الأخيرة من الرحلة؛ الانضباط الآن يُحسب لك."],["ما قبل المنافسة (تنشيف متقدم)","دعم","ثق بالعملية وبفريقك؛ التفاصيل الصغيرة تصنع الفرق في الأسابيع الأخيرة."],["ما قبل المنافسة (تنشيف متقدم)","دعم","الراحة والنوم جزء من التحضير مثل التمرين تماماً."],["ما قبل المنافسة (تنشيف متقدم)","دعم","التوتر طبيعي قبل المنافسة؛ التنفس والروتين الثابت يخففانه."],["ما قبل المنافسة (تنشيف متقدم)","دعم","لا تغيّر شيئاً جديداً قبل المنافسة دون الرجوع إليّ."],["ما قبل المنافسة (تنشيف متقدم)","دعم","كل أسبوع تنجزه هو استثمار في يوم المنافسة."],["ما قبل المنافسة (تنشيف متقدم)","إرشاد","اتبع الخطة حرفياً ولا تجرّب أطعمة أو مكملات جديدة."],["ما قبل المنافسة (تنشيف متقدم)","إرشاد","ثبّت مواعيد وجباتك وتمرينك وتحمّل تغييرات الأسبوع الأخير بإشراف الأخصائي فقط."],["ما قبل المنافسة (تنشيف متقدم)","إرشاد","سجّل وزنك وقياساتك وصورك بنفس الظروف لنقارن بدقة."],["ما قبل المنافسة (تنشيف متقدم)","إرشاد","حافظ على الترطيب المنتظم؛ لا تعدّل الماء أو الأملاح بنفسك."],["ما قبل المنافسة (تنشيف متقدم)","إرشاد","جهّز وجباتك مسبقاً لتتجنب الأخطاء."],["ما قبل المنافسة (تنشيف متقدم)","إرشاد","خطّط لما بعد المنافسة (العودة التدريجية للسعرات) منذ الآن."],["ما قبل المنافسة (تنشيف متقدم)","توقع","مرحلة التحضير النهائي تتطلب متابعة أقرب (أسبوعية أو أكثر)."],["ما قبل المنافسة (تنشيف متقدم)","توقع","قد تشعر بتعب وجوع أكبر؛ هذا متوقع لكنه يُبلَّغ عنه."],["ما قبل المنافسة (تنشيف متقدم)","توقع","القرارات الخاصة بالأسبوع الأخير تُتخذ بالتنسيق معي وحسب استجابتك."],["ما قبل المنافسة (تنشيف متقدم)","تنبيه","هذه المرحلة تحمل مخاطر أعلى؛ لا تتبع أساليب جفاف أو إفراط في الأملاح أو أدوية دون إشراف طبي."],["ما قبل المنافسة (تنشيف متقدم)","تنبيه","أي دوخة، خفقان، تشنج، أو إعياء شديد: توقف وتواصل مع طبيبك فوراً."],["بناء عضلي (فائض)","دعم","العضلات تُبنى بالتمرين والأكل والنوم؛ وأنت تفعل الثلاثة."],["بناء عضلي (فائض)","دعم","الفائض المدروس يبني عضلات أكثر ودهوناً أقل من الأكل العشوائي."],["بناء عضلي (فائض)","دعم","التقدم في الأحمال أهم من حجم الطعام."],["بناء عضلي (فائض)","دعم","الصبر الآن يصنع شكلاً مختلفاً بعد أشهر."],["بناء عضلي (فائض)","دعم","تناول طعامك كجزء من التدريب لا كمكافأة."],["بناء عضلي (فائض)","دعم","كل وجبة من خطتك لبنة في الجسم الذي تبنيه."],["بناء عضلي (فائض)","إرشاد","اجعل الهدف زيادة تدريجية بطيئة في الوزن؛ الزيادة السريعة تعني دهوناً أكثر."],["بناء عضلي (فائض)","إرشاد","ارفع الأحمال تدريجياً في التمرين؛ الطعام وحده لا يبني العضل."],["بناء عضلي (فائض)","إرشاد","وزّع البروتين على 3–5 وجبات، وأضف وجبة قبل النوم عند الحاجة."],["بناء عضلي (فائض)","إرشاد","الكارب الأعلى في أيام التدريب لدعم الأداء والاستشفاء."],["بناء عضلي (فائض)","إرشاد","إن صعب عليك إكمال الوجبات: ارفع الكثافة (مكسرات، زيوت، حليب، تمر) بدل الحجم."],["بناء عضلي (فائض)","إرشاد","سجّل وزنك ومقاس الخصر أسبوعياً لنراقب جودة الزيادة."],["بناء عضلي (فائض)","توقع","الزيادة المثالية بطيئة؛ إن زاد وزنك بسرعة أو زاد الخصر كثيراً نخفض الفائض."],["بناء عضلي (فائض)","توقع","إن لم يزد وزنك أو أحمالك 2–3 أسابيع مع الالتزام نرفع السعرات قليلاً."],["بناء عضلي (فائض)","توقع","نراجع الخطة كل 2–4 أسابيع حسب الوزن والأداء والخصر."],["بناء عضلي (فائض)","تنبيه","الأكل «بلا حساب» لا يناسب هدفك؛ الزيادة الدهنية السريعة تصعّب التنشيف لاحقاً."],["بناء عضلي (فائض)","تنبيه","استشر طبيبك قبل أي مكملات مع وجود حالة صحية أو أدوية."],["بناء نظيف (فائض صغير)","دعم","زيادة صغيرة ومنضبطة تعطي عضلات نظيفة بأقل دهون."],["بناء نظيف (فائض صغير)","دعم","الاتساق هنا أهم من الحماس؛ نفس الخطة، أسبوعاً بعد أسبوع."],["بناء نظيف (فائض صغير)","دعم","تقدمك بطيء لكنه مضمون؛ استمر."],["بناء نظيف (فائض صغير)","دعم","أحمالك في التمرين هي أهم مقياس؛ ارفعها تدريجياً."],["بناء نظيف (فائض صغير)","دعم","اجعل جودة الطعام والنوم شريكين لتمرينك."],["بناء نظيف (فائض صغير)","دعم","الصبر هنا ثمنه شكل أفضل."],["بناء نظيف (فائض صغير)","إرشاد","التزم بالفائض الصغير؛ لا ترفعه من نفسك."],["بناء نظيف (فائض صغير)","إرشاد","ركّز على مصادر البروتين الجيدة والكارب حول التدريب."],["بناء نظيف (فائض صغير)","إرشاد","أضف الألياف والخضار لصحة الهضم والشبع."],["بناء نظيف (فائض صغير)","إرشاد","راقب الخصر والوزن أسبوعياً وسجّل المتوسط."],["بناء نظيف (فائض صغير)","إرشاد","نم 7–9 ساعات وحافظ على الترطيب."],["بناء نظيف (فائض صغير)","توقع","الزيادة قد تبدو بطيئة جداً؛ هذا هو المقصود."],["بناء نظيف (فائض صغير)","توقع","إذا ثبت وزنك وأحمالك 3 أسابيع مع الالتزام نزيد السعرات قليلاً."],["بناء نظيف (فائض صغير)","تنبيه","لا تضف «وجبات غش» كثيرة؛ تفسد ضبط الفائض."],["بناء نظيف (فائض صغير)","تنبيه","عند أي أعراض غير معتادة تواصل معي."],["إعادة تركيب الجسم","دعم","إعادة التشكيل أبطأ لكنها تعطيك عضلات أكثر ودهوناً أقل معاً."],["إعادة تركيب الجسم","دعم","لا تتوقع قفزات؛ الصور والمقاسات والأحمال تحكي القصة أكثر من الميزان."],["إعادة تركيب الجسم","دعم","التمرين المنتظم مع البروتين العالي هو سرّك."],["إعادة تركيب الجسم","دعم","ثق بالعملية؛ التغير يحدث وإن لم يتحرك الميزان."],["إعادة تركيب الجسم","دعم","كل أسبوع تلتزم فيه يعطي نتيجة تراكمية."],["إعادة تركيب الجسم","دعم","قوتك تزداد؛ هذا دليل أنك على الطريق."],["إعادة تركيب الجسم","إرشاد","حافظ على بروتين مرتفع موزّع على الوجبات."],["إعادة تركيب الجسم","إرشاد","لا تهمل التمرين المقاوم؛ هو المحرك الرئيسي للتركيب."],["إعادة تركيب الجسم","إرشاد","قِس الخصر والأحمال والصور كل 2–4 أسابيع بدل الاعتماد على الميزان وحده."],["إعادة تركيب الجسم","إرشاد","ضع الكارب حول التدريب لدعم الأداء."],["إعادة تركيب الجسم","إرشاد","نم جيداً وتحرّك يومياً (خطوات) لدعم الحرق."],["إعادة تركيب الجسم","توقع","التغير بطيء ويحتاج أشهراً؛ نراجع كل 3–4 أسابيع."],["إعادة تركيب الجسم","توقع","إذا لم تتحسن المقاسات والأحمال بعد 4 أسابيع من الالتزام نعدّل السعرات قليلاً."],["إعادة تركيب الجسم","تنبيه","لا تضف عجزاً من عندك؛ العجز الكبير يعيق بناء العضل."],["إعادة تركيب الجسم","تنبيه","عند التعب الشديد أو اضطراب النوم تواصل معي."],["تثبيت / صيانة","دعم","الحفاظ على النتيجة مهارة؛ وأنت تتقنها."],["تثبيت / صيانة","دعم","الثبات الهادئ يمنحك حرية أكبر وطاقة أفضل."],["تثبيت / صيانة","دعم","نمط حياتك الآن هو نتيجتك الدائمة."],["تثبيت / صيانة","دعم","المرونة المحسوبة تحميك من الانتكاس."],["تثبيت / صيانة","دعم","استمتع بما بنيته وحافظ عليه."],["تثبيت / صيانة","دعم","التزامك المنتظم أقوى من أي نظام قاسٍ."],["تثبيت / صيانة","إرشاد","حافظ على نفس العادات: بروتين كافٍ، كارب حول التدريب، ماء، ونوم."],["تثبيت / صيانة","إرشاد","اسمح بمرونة بسيطة (80–90% التزام) دون تجاوز كبير."],["تثبيت / صيانة","إرشاد","قِس وزنك أسبوعياً؛ إن تغيّر اتجاهه أكثر من 2–3% تواصل معي."],["تثبيت / صيانة","إرشاد","استمر في التمرين المنتظم؛ هو ما يحميك."],["تثبيت / صيانة","توقع","يتذبذب الوزن قليلاً طبيعياً؛ نراقب الاتجاه لا اليوم."],["تثبيت / صيانة","توقع","نراجع الخطة كل 4–6 أسابيع."],["تثبيت / صيانة","تنبيه","لا تعتمد على الحرمان القاسي بعد فترة تنشيف؛ العودة التدريجية للسعرات أفضل."],["تثبيت / صيانة","تنبيه","تواصل معي عند أي تغير مفاجئ في الوزن أو الشهية."]],"prefs":{"maxProt":5.0,"maxAny":8.0,"maxItems":4.0,"veg":150.0,"egg":50.0},"days":["الأحد","الاثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"]}